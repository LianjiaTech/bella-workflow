# Middleware Infrastructure Configuration
# 通过 deploy-middleware.sh 脚本部署的中间件配置

## OpenAPI信息
BELLA_OPENAPI_HOST=https://openapi.example.com
BELLA_OPENAPI_BASE=https://openapi.example.com/v1/
BELLA_OPENAPI_URL=https://openapi.example.com
BELLA_SESSION_COOKIE_DOMAIN=example.com


BELLA_TOOL_API_ENABLED=false
BELLA_TOOL_API_BASE=http://bella-workflow-api

BELLA_DATASET_API_ENABLED=false
BELLA_DATASET_API_BASE=http://bella-workflow-api
BELLA_WORKFLOW_BACKEND_OUTER_URL=https://workflow.bella.top/
BELLA_CODE_SANDBOX_API_BASE=http://code-sandbox:8090/v1/
BELLA_MAX_EX_MEMORY_ALLOC=209715200
BELLA_LOGIN_TYPE=client
BELLA_SESSION_COOKIE_NAME=bella_openapi_sessionId
BELLA_WORKFLOW_RUN_LOG_PROVIDER=elasticsearch

# 时区配置
TZ=Asia/Shanghai

# MySQL 配置 (由deploy-middleware.sh部署)
MYSQL_HOST=bella-mysql
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=bella_workflow
MYSQL_USER=bella_workflow
MYSQL_PASSWORD=bella123
MYSQL_FILE_API_DATABASE=bella_file_api
MYSQL_FILE_API_USER=bella_user
MYSQL_FILE_API_PASSWORD=123456

# Redis 配置 (由deploy-middleware.sh部署)
REDIS_HOST=bella-redis
REDIS_PORT=6379
REDIS_PASSWORD=bella123

# Kafka 配置 (由deploy-middleware.sh部署)
KAFKA_HOST=bella-kafka
KAFKA_PORT=9092
KAFKA_EXTERNAL_HOST=localhost
KAFKA_EXTERNAL_PORT=19092
WORKFLOW_RUN_LOG_TOPIC=workflow_run_log
FILE_API_TOPIC=bella_file_api

# Elasticsearch 配置 (由deploy-middleware.sh部署)
ELASTICSEARCH_HOST=bella-elasticsearch
ELASTICSEARCH_HTTP_PORT=9200
ELASTICSEARCH_HOSTS=bella-elasticsearch:9200
ELASTICSEARCH_RUN_LOG_INDEX=workflow_run_log_*
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# MinIO 配置 (由deploy-middleware.sh部署)
MINIO_ROOT_USER=bella_admin
MINIO_ROOT_PASSWORD=bella123456
S3_HOST=bella-minio
S3_API_PORT=9000
S3_CONSOLE_PORT=9001
S3_ACCESS_KEY=bella_admin
S3_SECRET_KEY=bella123456
WORKFLOW_S3_BUCKET=bella-workflow
FILE_API_S3_BUCKET=bella-file-api
S3_BUCKET=bella-workflow
S3_ROOT_PATH=test-states

# Code Sandbox 配置 (在docker-compose.app.yaml中部署)
CODE_SANDBOX_HOST=bella-workflow-code-sandbox
CODE_SANDBOX_PORT=8090
CODE_SANDBOX_CONTAINER_NAME=bella-workflow-code-sandbox
CODE_SANDBOX_API_KEY=bella-workflow-sandbox
CODE_SANDBOX_GIN_MODE=release
CODE_SANDBOX_WORKER_TIMEOUT=15
CODE_SANDBOX_ENABLE_NETWORK=true
CODE_SANDBOX_TZ=UTC